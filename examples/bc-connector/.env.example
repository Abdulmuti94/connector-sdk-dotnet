# Vested AI Connector configuration
# Copy to .env and fill in real values before running.

# Required: connector JWT issued by the Vested AI platform.
VESTED_CONNECTOR_TOKEN=

# Required: hub gRPC endpoint in host:port form.
VESTED_CONNECTOR_HUB=hub.example.com:4443

# Optional: logging verbosity (Trace | Debug | Information | Warning | Error).
LOG_LEVEL=Information

# REQUIRED. The [Credential] attributes in BcUserCredentialHandler.cs are
# declared, and the SDK throws at startup without this key.
#
# This connector declares a credential_schema AND a relational_source together.
# That was impossible before 2026-08-16 — the hub refused schema extraction with
# 403 credential_gated whenever credentials were declared — so the two were
# briefly traded off. The core now names an automation principal for extraction
# (connectors.schema_automation_user_id), so both stand at once and this key is
# needed again.
#
# The private half of this connector's credential keypair, in PKCS#8
# PEM. Generate the pair in the Core project and register the PUBLIC half there;
# the private half must exist ONLY here. Users' Business Central credentials are
# sealed in the browser to the public key, so without this the worker cannot open
# them and every BC tool call fails.
#
# Key rotation: keep both keys here during the overlap, newest first, separated
# by a BLANK LINE. The SDK tries each in turn.
#
# VESTED_CREDENTIAL_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----"
#
# Or point at a file instead (preferred when your secret store mounts files):
# VESTED_CREDENTIAL_PRIVATE_KEY_FILE=/run/secrets/vested-credential-key.pem

# --- On-prem Dynamics 365 Business Central (ASG AI Gateway over ODataV4, NavUserPassword basic auth) ---

# Required: Business Central ODataV4 base URL (only OData Services need to be
# enabled on the service instance — not API Services).
# Pattern: http(s)://<host>:<port>/<serverinstance>/ODataV4
BC_BASE_URL=https://bc-host:8048/BC/ODataV4

# Required: default company name exactly as shown in Business Central (maps to country SA).
BC_COMPANY=ASG

# Optional: country|company|gatewayId mappings (semicolon-separated).
# Pre-configuring gatewayId skips the aiGateway lookup on first call per company.
# BC_COMPANY_MAP="SA|ASG|3c4b6c11-7f63-f111-8483-6045bd6a7964;KW|ASG - KWT|;OM|ASG - OM|;QA|ASG - QAR|;AE|ASG - UAE|"

# NOTE: there is no BC_USERNAME / BC_PASSWORD any more.
#
# Every gateway tool call authenticates as the PERSON WHO ASKED, using the
# Business Central user name and Web Service Access Key they store themselves
# (sealed to this connector's public key — see VESTED_CREDENTIAL_PRIVATE_KEY
# above). That is what makes BC's own permission sets and security filters apply
# and puts a real name in the Change Log.
#
# Consequences worth planning for:
#   - Every agent user needs a BC account and their own Web Service Access Key
#     (BC → Users → the user → Web Service Access Key).
#   - A call with no stored credential FAILS with an actionable message. It does
#     not fall back to a shared identity.
#   - Company access is now per user; BC denies what a user cannot reach, so the
#     connector no longer probes or narrows the company list at startup.

# Optional: per-request HTTP timeout in seconds (default 120).
# Keep it at or above the largest tool deadline (net_inventory and
# available_inventory declare 120s) - this timeout fires first if it is lower.
BC_TIMEOUT_SECONDS=120

# --- Optional: direct read-only SQL (enables the erp_bc.data.run_sql tool) ---
# Leave all BC_SQL_* unset to keep the SQL query tool disabled.
# Use a least-privilege login (GRANT SELECT; DENY INSERT/UPDATE/DELETE/EXEC) — that
# is the real "SELECT only" guarantee; BcSqlGuard is defense-in-depth on top.

# Option A: full connection string (takes precedence over the discrete vars below).
# BC_SQL_CONNECTION=Server=bc-sql\BC;Database=BC_DB;User ID=ReadOnlyUser;Password=...;ApplicationIntent=ReadOnly;Encrypt=True;TrustServerCertificate=True

# Option B: discrete settings (the connector builds a read-only, encrypted connection string).
# BC_SQL_SERVER=bc-sql\BC
# BC_SQL_DATABASE=BC_DB
# BC_SQL_USERNAME=ReadOnlyUser
# BC_SQL_PASSWORD=
# BC_SQL_TRUST_CERT=true          # false to require a CA-signed server certificate

# Optional tuning.
# BC_SQL_TIMEOUT_SECONDS=60        # connect + command timeout (no row cap — queries should use TOP)
# BC_SQL_ALLOWED_SCHEMAS=ai        # restrict run_sql to a curated read-only view schema
#                                  # (does NOT apply to catalog reads — see below)

# --- Optional: schema extraction (erp_bc.data.describe_schema) ---
# Uses the SAME BC_SQL_* connection. Unset it and the relational source is still
# declared, but reports an empty fingerprint and a clear "not configured" error —
# never an empty schema, which would ingest as "this database has no tables".
# BC_SQL_CATALOG_TIMEOUT_SECONDS=300  # command timeout for the full sys.columns scan
# BC_SQL_CATALOG_CACHE_SECONDS=300    # how long the catalog stays in memory; 0 disables
#                                     # ⚠ the cache holds EVERY table and column in the
#                                     # database (~26k tables / ~2M columns on ASG,
#                                     # est. ~250 MB). The first read logs the real counts.

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BcConnector</AssemblyName>
    <RootNamespace>BcConnector</RootNamespace>
    <Description>On-prem Dynamics 365 Business Central connector example for VestedAI.ConnectorSdk.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="VestedAI.ConnectorSdk" Version="0.2.0" />
  </ItemGroup>
</Project>
